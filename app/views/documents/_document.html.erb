<tr>
  <td scope="row">
    <%= highlight document.name, params.dig(:q, :name_cont) %>
  </td>
  <td scope="row">
    <%= l document.date if document.date %>
  </td>
  <td scope="row">
    <% if document.file.previewable? %>
      <%= link_to image_tag(document.file.preview(resize_to_limit: [90, 90])),
                  rails_blob_path(document.file, disposition: 'attachment') %>
    <% else %>
      <%= link_to tag.i(class: 'fa fa-download pl-4', aria_hidden: true),
                  rails_blob_path(document.file, disposition: 'attachment') %>
    <% end %>
  </td>
  <td scope="row">
    <% if policy(Document).destroy? %>
      <%= link_to t('main_app.views.application.buttons.destroy'),
                  document,
                  method: :delete,
                  id: document.id,
                  class: 'btn btn-mini btn-danger',
                  data: {
                    confirm: t('main_app.views.application.buttons.destroy_confirm',
                               model: Document.model_name.human),
                    remote: true
                  } %>
    <% end %>
  </td>
</tr>
