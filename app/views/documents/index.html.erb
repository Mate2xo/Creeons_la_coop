<div class="container mb-4">
  <main class="main-content">

    <header class="page-title">
      <h2
        class="
          heading-infos heading heading-2 text-uppercase border-bottom border-dark
          strong-800 mt-5 mb-5
        "
      >
        <%= t '.title' %>
      </h2>
    </header>

    <article class="" id="documents">
      <%= render 'documents/new', document: @new_document if policy(Document).create? %>

      <br>
      <div class="card no-border">
        <div class="widget mt-4">
          <section class="row-wrapper">
            <ul class="nav nav-tabs justify-content-center mb-5" role="tablist">
              <% Document.category.values.each_with_index do |category, index| %>
                <li class="nav-item">
                  <a
                    class="nav-link <%= 'active' if index.zero? %>"
                    data-toggle="tab"
                    href="#<%= category %>"
                  >
                    <%= t "enumerize.document.category.#{category}" %>
                  </a>
                </li>
              <% end %>
            </ul>
          </section>
          <section class="row-wrapper">
            <div class="tab-content" id="myTabContent">
              <% Document.category.values.each_with_index do |category, index| %>
                <div
                  class="
                    tab-pane fade show <%= 'active' if index.zero? %>
                  "
                  id="<%= category %>"
                  role="tabpanel"
                  aria-labelledby="<%= category %>-tab"
                >
                  <div class="row cols-md-space cols-sm-space cols-xs-space">
                    <table id="documents" class="table table-sm table-hover">
                      <thead>
                        <tr>
                          <th scope="col"><%= t '.name' %></th>
                          <th scope="col"><%= t '.date' %></th>
                          <th scope="col"><%= t '.download' %></th>
                        </tr>
                      </thead>

                      <tbody>
                        <%= render partial: 'documents/document',
                                   collection: @documents.select { |document| document.category == category } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              <% end %>
            </div>
          </section>
        </div>
      </div>
    </article>
  </main>
</div>
