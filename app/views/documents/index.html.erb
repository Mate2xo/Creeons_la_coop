<div class="container mb-4">
  <main class="main-content">

    <header class="page-title">
      <h2
        class="
          heading-infos heading heading-2 text-uppercase border-bottom border-dark
          strong-800 mt-5 mb-5
        "
      >
        <%= t '.title' %>
      </h2>
    </header>

    <%= search_form_for @q, class: 'text-center form-inline justify-content-center' do |f| %>
      <%= f.label :name_cont, class: 'sr-only' %>
      <%= f.search_field :name_cont, class: 'form-control mx-sm-2', placeholder: 'nom' %>

      <%= f.label :category, class: 'sr-only' %>
      <%= f.select :category_id_eq,
                   Documents::Category.pluck(:name, :id),
                   {include_blank: t('.all_categories')},
                   {class: 'custom-select mx-sm-2'} %>

      <%= f.submit t('.search'), class: 'btn btn-success' %>
    <% end %>

    <article class="" id="documents">
      <div class="card no-border">
        <div class="widget mt-4">
          <hr>
          <section class="row-wrapper">
            <div class="row cols-md-space cols-sm-space cols-xs-space">
              <table id="documents" class="table table-sm table-hover">
                <thead>
                  <tr>
                    <th scope="col"><%= sort_link @q, :name %></th>
                    <th scope="col"><%= sort_link @q, :date %></th>
                    <th scope="col"><%= t '.download' %></th>
                  </tr>
                </thead>

                <tbody>
                  <%= render partial: 'documents/document', collection: @documents %>
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </div>
    </article>
  </main>
</div>
